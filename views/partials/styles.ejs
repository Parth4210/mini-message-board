        .page {
            padding-top: 42px;
        }

        .page__intro {
            align-items: start;
            flex-direction: column;
        }

        .message {
            padding: 21px;
        }

        .message__meta {
            align-items: start;
            flex-direction: column;
            gap: 4px;
        }
    }
