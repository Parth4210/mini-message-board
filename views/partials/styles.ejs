<style>
    :root {
        --ink: #17212b;
        --muted: #6b7785;
        --paper: #f6f7f9;
        --surface: #ffffff;
        --line: #e3e7ec;
        --accent: #d7664a;
        --accent-dark: #b94d35;
        --shadow: 0 14px 35px rgba(23, 33, 43, 0.08);
    }

    * {
        box-sizing: border-box;
    }

    body {
        min-height: 100vh;
        margin: 0;
        color: var(--ink);
        background: var(--paper);
        font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        line-height: 1.5;
    }

    a {
        color: inherit;
    }

    .site-header {
        border-bottom: 1px solid var(--line);
        background: rgba(255, 255, 255, 0.86);
    }

    .site-header__inner,
    .page {
        width: min(100% - 40px, 860px);
        margin: 0 auto;
    }

    .site-header__inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        min-height: 72px;
        gap: 24px;
    }

    .brand {
        font-size: 0.95rem;
        font-weight: 750;
        letter-spacing: 0.02em;
        text-decoration: none;
    }

    .brand span {
        color: var(--accent);
    }

    .nav-link,
    .button {
        border-radius: 7px;
        font-size: 0.9rem;
        font-weight: 700;
        text-decoration: none;
        transition: background-color 160ms ease, border-color 160ms ease, color 160ms ease, transform 160ms ease;
    }

    .nav-link {
        padding: 9px 13px;
        color: var(--muted);
    }

    .nav-link:hover {
        color: var(--ink);
        background: #f0f2f5;
    }

    .page {
        padding: 64px 0 80px;
    }

    .page__intro {
        display: flex;
        align-items: end;
        justify-content: space-between;
        margin-bottom: 28px;
        gap: 24px;
    }

    h1 {
        max-width: 620px;
        margin: 0;
        font-size: clamp(2rem, 5vw, 3.1rem);
        line-height: 1.08;
        letter-spacing: -0.045em;
    }

    .eyebrow {
        margin: 0 0 10px;
        color: var(--accent);
        font-size: 0.75rem;
        font-weight: 800;
        letter-spacing: 0.14em;
        text-transform: uppercase;
    }

    .message-list {
        display: grid;
        gap: 14px;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .message {
        padding: 24px 26px;
        border: 1px solid var(--line);
        border-radius: 10px;
        background: var(--surface);
        box-shadow: var(--shadow);
    }

    .message__text {
        margin: 0 0 17px;
        font-size: 1.08rem;
        line-height: 1.55;
    }

    .message__meta {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        color: var(--muted);
        font-size: 0.82rem;
    }

    .message__author {
        color: var(--ink);
        font-weight: 750;
    }

    .form-card {
        max-width: 620px;
        padding: clamp(25px, 5vw, 42px);
        border: 1px solid var(--line);
        border-radius: 10px;
        background: var(--surface);
        box-shadow: var(--shadow);
    }

    .form-card h1 {
        margin-bottom: 30px;
    }

    .field {
        display: grid;
        gap: 8px;
        margin-bottom: 22px;
    }

    label {
        font-size: 0.88rem;
        font-weight: 750;
    }

    input {
        width: 100%;
        padding: 12px 13px;
        border: 1px solid #cfd6de;
        border-radius: 6px;
        color: var(--ink);
        background: #fbfcfd;
        font: inherit;
        outline: none;
        transition: border-color 160ms ease, box-shadow 160ms ease, background-color 160ms ease;
    }

    input::placeholder {
        color: #9aa4af;
    }

    input:focus {
        border-color: var(--accent);
        background: var(--surface);
        box-shadow: 0 0 0 3px rgba(215, 102, 74, 0.16);
    }

    .button {
        display: inline-block;
        padding: 11px 17px;
        border: 1px solid var(--accent);
        color: #fff;
        background: var(--accent);
        cursor: pointer;
    }

    .button:hover {
        border-color: var(--accent-dark);
        background: var(--accent-dark);
        transform: translateY(-1px);
    }

    .button:focus-visible,
    .nav-link:focus-visible {
        outline: 3px solid rgba(215, 102, 74, 0.35);
        outline-offset: 2px;
    }

    @media (max-width: 600px) {
